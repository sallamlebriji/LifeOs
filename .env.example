# ─── LifeOS local development environment ───────────────────────────────
# Copy to .env (root) — apps and packages read from here. Never commit .env.

NODE_ENV=development
APP_TIMEZONE=Africa/Casablanca

# MySQL 8 (docker compose exposes it on host port 3307)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lifeos
MYSQL_USER=lifeos
MYSQL_PASSWORD=change-me
DATABASE_URL="mysql://lifeos:change-me@localhost:3307/lifeos"
# Used by integration tests (created automatically by infrastructure/docker/mysql/init.sql)
TEST_DATABASE_URL="mysql://lifeos:change-me@localhost:3307/lifeos_test"
# Shadow DB used only by `prisma migrate dev`
SHADOW_DATABASE_URL="mysql://lifeos:change-me@localhost:3307/lifeos_shadow"

# Redis 7
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4010
API_PUBLIC_URL="http://localhost:4010"
WEB_ORIGIN="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Email delivery: "log" prints verification/reset links to the API console (dev only).
MAIL_TRANSPORT=log

# Web
API_INTERNAL_URL="http://localhost:4010"
